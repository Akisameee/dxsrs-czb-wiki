---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="武学配装模拟器" active="loadout">
  <main class="app-shell resizable-split" data-split-id="loadout" data-split-default="61" data-split-min-left="320" data-split-min-right="320">
    <section class="picker-pane" aria-label="武功选择">
      <header class="topbar">
        <div>
          <h1>武学配装模拟器</h1>
          <p id="data-status" class="status-text">读取数据中</p>
        </div>
        <div class="selection-meter" aria-live="polite">
          <strong id="selected-count">0</strong>
          <span>/ 12</span>
        </div>
      </header>

      <div class="controls">
        <fieldset class="filter-set">
          <legend>门派</legend>
          <div id="sect-filter" class="radio-group"></div>
        </fieldset>
        <fieldset class="filter-set">
          <legend>风格</legend>
          <div id="style-filter" class="radio-group"></div>
        </fieldset>
      </div>

      <section class="control-row extra-controls" aria-label="额外词条">
        <div id="equipment-style-controls" class="control-col control-panel control-panel--titled extra-card">
          <div class="control-panel-title extra-card-head">
            <strong>装备风格词条</strong>
          </div>
        </div>

        <div class="control-col control-panel control-panel--titled extra-card">
          <div class="control-panel-title extra-card-head">
            <label class="toggle-line">
              <input id="custom-enabled" type="checkbox" />
              <span>自创外功</span>
            </label>
          </div>
          <label class="control-field">
            <span>门派</span>
            <select id="custom-sect"></select>
          </label>
          <label class="control-field">
            <span>风格</span>
            <select id="custom-style"></select>
          </label>
        </div>
      </section>

      <div class="selected-bar">
        <div id="selected-list" class="selected-strip" aria-label="已选武功"></div>
        <button id="clear-button" class="icon-button" type="button" title="清空选择" aria-label="清空选择">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div id="martial-list" class="martial-grid" aria-label="武功列表"></div>
    </section>

    <div class="split-resizer" data-split-resizer role="separator" aria-label="调整左右栏宽度" aria-orientation="vertical" tabindex="0"></div>

    <aside class="results-pane" aria-label="连锁词条">
      <section class="summary-band">
        <div>
          <span class="summary-label">门派</span>
          <div id="sect-summary" class="summary-list"></div>
        </div>
        <div>
          <span class="summary-label">风格</span>
          <div id="style-summary" class="summary-list"></div>
        </div>
      </section>

      <section>
        <div class="section-head">
          <h2>连锁词条</h2>
        </div>
        <div id="chain-list" class="chain-list"></div>
      </section>
    </aside>
  </main>

  <script>
    import "../../shared/split-resizer.js";
    import "../../tools/loadout/main.js";
  </script>
</BaseLayout>
