---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="自创武功模拟器" active="self-create">
  <main class="self-create-shell">
    <section class="self-create-panel" aria-label="自创参数">
      <header class="topbar">
        <div>
          <h1>自创武功模拟器</h1>
          <p id="self-create-status" class="status-text">读取数据中</p>
        </div>
      </header>

      <form id="self-create-form" class="self-create-form">
        <section class="form-card">
          <h2>初始四维</h2>
          <div class="number-grid">
            <label>
              <span>意念</span>
              <input name="yi" type="number" min="0" max="10" value="5" />
            </label>
            <label>
              <span>气劲</span>
              <input name="qi" type="number" min="0" max="10" value="5" />
            </label>
            <label>
              <span>形态</span>
              <input name="xing" type="number" min="0" max="10" value="5" />
            </label>
            <label>
              <span>神韵</span>
              <input name="shen" type="number" min="0" max="10" value="5" />
            </label>
          </div>
        </section>

        <section class="form-card">
          <h2>武功</h2>
          <div class="number-grid two">
            <label>
              <span>名称</span>
              <input name="name" type="text" value="自创武功" />
            </label>
            <label>
              <span>武器类型</span>
              <select id="weapon-type" name="weaponType"></select>
            </label>
            <label>
              <span>改良次数</span>
              <input id="improve-steps" name="steps" type="number" min="0" max="20" value="5" />
            </label>
          </div>
        </section>

        <section class="form-card lock-card">
          <h2>改良锁定</h2>
          <div id="lock-rows" class="lock-rows"></div>
        </section>

        <button class="primary-button" type="submit">模拟</button>
      </form>
    </section>

    <section class="self-create-results" aria-label="模拟结果">
      <div class="section-head">
        <h2>结果时间线</h2>
      </div>
      <div id="self-create-result" class="timeline-list">
        <div class="empty-state">读取数据中。</div>
      </div>
    </section>
  </main>

  <script>
    import "../../tools/self-create/page.js";
  </script>
</BaseLayout>
