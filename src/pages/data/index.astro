---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="数据总览 - 大侠式人生重制版" active="data">
  <main class="characters-shell data-overview-page">
    <section class="characters-head">
      <div>
        <h1>wiki.sqlite</h1>
        <p id="data-overview-status" class="status-text">直接浏览 public/data/wiki.sqlite 中的表和字段。</p>
      </div>
    </section>

    <section class="characters-controls" aria-label="数据筛选">
      <label>
        <span>表</span>
        <select id="data-table-select"></select>
      </label>
      <label>
        <span>表内搜索</span>
        <input id="data-table-search" type="search" placeholder="按当前表字段搜索" />
      </label>
    </section>

    <section class="character-results" aria-label="wiki.sqlite 表数据">
      <div class="character-result-head">
        <span id="data-table-count">读取中...</span>
        <div id="data-table-pager"></div>
      </div>
      <div class="data-table-wrap">
        <table class="data-overview-table" id="data-table">
          <thead id="data-table-head"></thead>
          <tbody id="data-table-body"></tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import "../../data/overview-page.js";
</script>
