---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="人物地点索引 - 大侠式人生重制版" active="characters">
  <main class="characters-shell">
    <section class="characters-head">
      <div>
        <h1>人物地点索引</h1>
        <p id="characters-status" class="status-text">按 location 查看 NPC 所在位置、属性和武功配置。</p>
      </div>
    </section>

    <section class="characters-controls" aria-label="人物筛选">
      <label>
        <span>搜索人物</span>
        <input id="character-search" type="search" placeholder="输入姓名" />
      </label>
      <label>
        <span>门派</span>
        <select id="character-sect"></select>
      </label>
      <label>
        <span>资质</span>
        <select id="character-rare"></select>
      </label>
      <label>
        <span>武器</span>
        <select id="character-weapon"></select>
      </label>
      <label>
        <span>武功路线</span>
        <select id="character-martial-type"></select>
      </label>
    </section>

    <section class="characters-workbench">
      <aside class="location-index" aria-label="Location 索引">
        <div class="location-index-head">
          <strong>Location</strong>
          <button id="location-all" type="button" class="location-button is-active">全部</button>
          <button id="location-unplaced" type="button" class="location-button">无地点</button>
        </div>
        <div id="location-tree" class="location-tree"></div>
      </aside>

      <section class="character-results" aria-label="人物列表">
        <div class="character-result-head">
          <span id="character-count">读取中...</span>
          <div id="character-pager"></div>
        </div>
        <div id="character-list" class="character-grid"></div>
      </section>
    </section>
  </main>
</BaseLayout>

<script>
  import "../../characters/index-page.js";
</script>
