---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="武学图鉴 - 大侠式人生重制版" active="martial">
  <main class="characters-shell">
    <section class="characters-head">
      <div>
        <h1>武学图鉴</h1>
        <p id="martial-arts-status" class="status-text">查看武学的门派、类型、风格、效果和获取方式。</p>
      </div>
    </section>

    <section class="characters-controls" aria-label="武学筛选">
      <label>
        <span>搜索武学</span>
        <input id="martial-art-search" type="search" placeholder="输入名称" />
      </label>
      <label>
        <span>门派</span>
        <select id="martial-art-sect"></select>
      </label>
      <label>
        <span>类型</span>
        <select id="martial-art-type"></select>
      </label>
      <label>
        <span>品质</span>
        <select id="martial-art-rare"></select>
      </label>
      <label>
        <span>风格</span>
        <select id="martial-art-style"></select>
      </label>
    </section>

    <section class="character-results" aria-label="武学列表">
      <div class="character-result-head">
        <span id="martial-art-count">读取中...</span>
      </div>
      <div id="martial-art-list" class="martial-grid"></div>
    </section>
  </main>
</BaseLayout>

<script>
  import "../../martial-arts/index-page.js";
</script>
