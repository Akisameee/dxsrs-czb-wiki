---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";

const {
  title,
  active = "home",
  dataRoot = `${import.meta.env.BASE_URL}data/`,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body data-data-root={dataRoot}>
    <SiteNav active={active} />
    <slot />
  </body>
</html>
